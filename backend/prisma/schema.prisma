generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  admin
  support
}

enum WalletTransactionType {
  deposit
  charge
  refund
  adjustment
}

enum PaymentProvider {
  stripe
}

enum PaymentStatus {
  pending
  succeeded
  failed
  canceled
}

enum OrderStatus {
  pending
  queued
  processing
  completed
  partial
  canceled
  failed
}

enum TicketStatus {
  open
  answered
  resolved
  closed
}

enum GrowthPlatform {
  instagram
  tiktok
  youtube
  facebook
  x
  linkedin
}

enum GrowthTimeframe {
  one_month
  three_months
  six_months
  twelve_months
  not_sure
}

enum GrowthAccountType {
  creator
  business
}

/// Lifecycle of a growth request, from lead capture to delivery.
enum GrowthRequestStatus {
  submitted
  under_review
  plan_ready
  active
  paused
  completed
}

enum GrowthQuoteStatus {
  quoted
  awaiting_payment
  ordered
  cancelled
  failed
}

enum GrowthPlanStatus {
  draft
  shared
  accepted
  changes_requested
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  fullName         String?
  passwordHash     String?
  refreshTokenHash String?
  provider         String   @default("email")
  role             UserRole @default(customer)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wallet Wallet?
  orders Order[]
  adminActionLogs AdminActionLog[]
  tickets Ticket[]
  ticketMessages TicketMessage[]
  growthRequests GrowthRequest[]
}

model Wallet {
  id            String              @id @default(cuid())
  userId        String              @unique
  balance       Decimal             @default(0) @db.Decimal(12, 2)
  currency      String              @default("USD")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
  payments      Payment[]
}

model Platform {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categories  Category[]
  services    Service[]

  @@index([isActive, sortOrder])
}

model Category {
  id          String    @id @default(cuid())
  platformId  String
  name        String
  slug        String
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  platform    Platform  @relation(fields: [platformId], references: [id], onDelete: Cascade)
  services    Service[]

  @@unique([platformId, slug])
  @@index([platformId, isActive, sortOrder])
}

model Service {
  id            String    @id @default(cuid())
  platformId    String
  categoryId    String
  name          String
  slug          String    @unique
  providerServiceId String?
  description   String
  shortDescription String?
  pricePerK     Decimal   @db.Decimal(12, 2)
  minOrder      Int
  maxOrder      Int
  deliverySpeed String?
  guarantee     String?
  refillPolicy  String?
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  platform      Platform  @relation(fields: [platformId], references: [id], onDelete: Restrict)
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orders        Order[]
  growthQuotes  GrowthQuote[]

  @@index([platformId, categoryId, isActive, sortOrder])
  @@index([isFeatured, isActive, sortOrder])
}

model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  providerRef   String?
  reference     String?
  amount        Decimal               @db.Decimal(12, 2)
  balanceBefore Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @db.Decimal(12, 2)
  currency      String                @default("USD")
  type          WalletTransactionType
  description   String?
  metadata      Json?
  status        String                @default("completed")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([type, createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  walletId          String
  provider          PaymentProvider @default(stripe)
  status            PaymentStatus   @default(pending)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("USD")
  checkoutSessionId String          @unique
  paymentIntentId   String?         @unique
  providerRef       String?
  description       String?
  metadata          Json?
  creditedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([status, createdAt])
}

model Order {
  id                String           @id @default(cuid())
  userId            String
  serviceId         String
  quantity          Int
  chargeAmount      Decimal          @db.Decimal(12, 2)
  currency          String           @default("USD")
  targetUrl         String
  status            OrderStatus      @default(pending)
  providerServiceId String?
  providerOrderId   String?          @unique
  startCount        Int?
  remains           Int?
  notes             String?
  canceledAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  service           Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  statusLogs        OrderStatusLog[]
  tickets           Ticket[]
  growthQuote       GrowthQuote?

  @@index([userId, createdAt])
  @@index([serviceId, createdAt])
  @@index([status, createdAt])
}

model OrderStatusLog {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  message     String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OutboxEvent {
  id            String   @id @default(cuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  status        String   @default("pending")
  attempts      Int      @default(0)
  lastError     String?
  availableAt   DateTime @default(now())
  processedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model QueueJobLog {
  id         String   @id @default(cuid())
  queueName  String
  jobName    String
  status     String
  payload    Json?
  createdAt  DateTime @default(now())
}

model AdminActionLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
}

model Ticket {
  id              String       @id @default(cuid())
  userId          String
  orderId         String?
  growthRequestId String?      @unique
  subject         String
  status          TicketStatus @default(open)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  growthRequest GrowthRequest? @relation(fields: [growthRequestId], references: [id], onDelete: Cascade)

  messages TicketMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// A customer-submitted growth objective. The target audience is the customer's
/// stated goal, never a promised outcome.
model GrowthRequest {
  id              String              @id @default(cuid())
  userId          String?
  accountType     GrowthAccountType   @default(creator)
  platform        GrowthPlatform
  profile         String
  currentAudience Int
  targetAudience  Int
  timeframe       GrowthTimeframe     @default(not_sure)
  niche           String?
  companyName     String?
  website         String?
  industry        String?
  targetMarket    String?
  country         String?
  contactName     String
  email           String
  phone           String?
  status          GrowthRequestStatus @default(submitted)
  internalNotes   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user              User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan              GrowthPlan?
  progressSnapshots GrowthProgressSnapshot[]
  /// The private thread the customer and the team use for this goal.
  ticket            Ticket?
  quotes            GrowthQuote[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email, createdAt])
}

/// The personalized plan the TrendK team prepares for a growth request.
model GrowthPlan {
  id                String           @id @default(cuid())
  requestId         String           @unique
  title             String
  summary           String
  strategy          String
  components        String[]         @default([])
  estimatedTimeline String?
  price             Decimal?         @db.Decimal(12, 2)
  currency          String           @default("USD")
  notes             String?
  status            GrowthPlanStatus @default(draft)
  sharedAt          DateTime?
  respondedAt       DateTime?
  customerNote      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  request GrowthRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

/// A priced offer the assistant put in front of the customer for one goal.
/// It carries the catalogue service and quantity the order is placed with once
/// the customer has paid, so quoting and fulfilment can never drift apart.
model GrowthQuote {
  id            String            @id @default(cuid())
  requestId     String
  serviceId     String
  quantity      Int
  unitPricePerK Decimal           @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  currency      String            @default("USD")
  targetUrl     String
  status        GrowthQuoteStatus @default(quoted)
  orderId       String?           @unique
  failureReason String?
  confirmedAt   DateTime?
  orderedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  request GrowthRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  order   Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([status, updatedAt])
}

/// Audience readings recorded by the TrendK team. Nothing here is generated
/// automatically, so the dashboard only ever shows values a human entered.
model GrowthProgressSnapshot {
  id         String   @id @default(cuid())
  requestId  String
  audience   Int
  note       String?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  request GrowthRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, recordedAt])
}

model TicketMessage {
  id       String  @id @default(cuid())
  ticketId String
  authorId String
  isStaff  Boolean @default(false)
  /// Written by the automated assistant rather than a human team member.
  isBot    Boolean @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

