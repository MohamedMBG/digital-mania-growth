NODE_ENV=production
PORT=4000
API_PREFIX=api
FRONTEND_URL=https://trendk.example.com
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://trendk_app:replace-with-the-same-database-password@postgres:5432/trendk?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=trendk_refresh

STRIPE_SECRET_KEY=sk_live_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_CURRENCY=usd
STRIPE_CHECKOUT_SUCCESS_URL=https://trendk.example.com/wallet/success
STRIPE_CHECKOUT_CANCEL_URL=https://trendk.example.com/wallet/cancel

PROVIDER_URL=https://smmfollows.com/api/v2
PROVIDER_API_KEY=replace-with-provider-api-key

LOG_LEVEL=warn
BULLMQ_PREFIX=trendk
CACHE_TTL_SECONDS=120

ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=Platform Admin
